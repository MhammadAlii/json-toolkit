# Public production URL, no trailing slash. Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://jsontoolkit.example.com

# Google AdSense. Leave empty to render no ads (dev shows dashed placeholders instead).
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_BELOW=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# Google Search Console HTML-tag verification token (content="..." value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Legal / contact details (see src/lib/legal.ts for defaults).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_JURISDICTION=
